FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

tol           1e-12;
solvers
{
    p
    {
        solver          PCG; // GAMG or PCG or smoothSolver
        smoother        symGaussSeidel; // DIC FDIC symGaussSeidel GaussSeidel
        preconditioner  DIC;  // GAMG, DIC, DILU, FDIC
        tolerance       $tol;
        relTol          1e-4;
        maxIter         500;
    }

    pFinal
    {
        $p;
        // solver          PCG;
        relTol          0;
    }

    U
    {
        //type            coupled;
        solver          PBiCGStab;
        //solver          PBiCCCG;
        preconditioner  DILU;
        smoother        symGaussSeidel;
        tolerance       $tol;
        //tolerance       (1e-10 1e-8 1);
        relTol          1e-4;
        //relTol          (0.01 0.01 1);
    }

    UFinal
    {
        $U;
        relTol          0;
    }

    "(c|psi|chi|xi)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        smoother        DILU;
        tolerance       $tol;
        relTol          1e-3;
        // maxIter         20;
    }

    "(c|psi|chi|xi)Final"
    {
        $c;
        relTol          0;
    }

}

"PIMPLE|PISO|SIMPLE"
{
    consistent yes;
    momentumPredictor   off;
    nOuterCorrectors    1;//100;  // PIMPLE loops
    nCorrectors         3;   // pressure loop
    nNonOrthogonalCorrectors 2;
    pRefCell            0;
    pRefValue           0;
    turbOnFinalIterOnly no;
    residualControl
    {
        ".*"           $tol;
    }
    outerCorrectorResidualControl //residualControl
    {
        ".*"
        {
            tolerance $tol;
            relTol    1e-4;
        }
    }
}

relaxationFactors
{
    equations
    {
        U 0.95;
        p 1;
        chi 0.98;
    }
    fields
    {
        U 1;
        p 1;
    }
}


